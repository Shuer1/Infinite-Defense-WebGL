# 仅让超大文件走 LFS（比如大型 3D 模型、高清纹理包）
*.bin filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text

# 强制 Pages 所需文件走普通 Git（关键！）
*.html !filter !diff !merge text
*.js !filter !diff !merge text
*.css !filter !diff !merge text
*.png !filter !diff !merge text  # 小图片排除 LFS，大图片可单独指定路径
*.jpg !filter !diff !merge text
*.gltf !filter !diff !merge text